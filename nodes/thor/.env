# thor — Jetson AGX Thor 128GB — JetPack 7 (L4T r38.4), CUDA 13.0, driver 580
# Upstream vLLM arm64 (CUDA 13) is what Jetson AI Lab's JetPack-7 tutorials use on Thor
# (they show v0.26.0). Pinned to v0.27.1 because the Nemotron 3.5 Lightning and
# Nemotron Super model cards name it. v0.29.0 (2026-09-09) is the newest if a model needs it.
VLLM_IMAGE=vllm/vllm-openai:v0.27.1
# Proven on this Thor for NVFP4 (served Qwen3-Coder-Next for 10 days) but is vLLM 0.19 —
# too old for Nemotron 3.5 / Omni. Fallback for Qwen3-VL-8B / Qwen3-8B only.
VLLM_JETSON_IMAGE=ghcr.io/nvidia-ai-iot/vllm:0.19.0-r38.2.arm64-sbsa-cu130-24.04
HF_HOME=/home/amigx/.cache/huggingface
VLLM_CACHE=/home/amigx/.cache/vllm
MEDIA_DIR=/home/amigx/inference/media
