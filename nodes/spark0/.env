# spark0 — NVIDIA DGX Spark (GB10) 128GB — DGX OS 7.5, CUDA 13.0, driver 580.159
# NVIDIA's DGX Spark playbooks use vllm/vllm-openai:latest (Qwen3.6) and pin v0.27.1 for
# Nemotron 3.5 Lightning and Nemotron 3 Super. NGC alternative: nvcr.io/nvidia/vllm:26.05.post1-py3
VLLM_IMAGE=vllm/vllm-openai:v0.27.1
HF_HOME=/home/amigx/.cache/huggingface
VLLM_CACHE=/home/amigx/.cache/vllm
PLUGINS_DIR=/home/amigx/inference/plugins
MEDIA_DIR=/home/amigx/inference/media
